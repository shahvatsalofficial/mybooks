# syntax=docker/dockerfile:1.4
# ═══════════════════════════════════════════════════════════════════════
# Stage 1: Build & Compilation Environment (builder)
# ═══════════════════════════════════════════════════════════════════════
FROM python:3.12-alpine AS builder

WORKDIR /build

# Install essential native compilation toolchains
RUN apk add --no-cache \
    gcc \
    musl-dev \
    libpq-dev \
    libffi-dev \
    build-base

# Create isolated virtual environment
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Install production dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip wheel && \
    pip install --no-cache-dir -r requirements.txt

# ═══════════════════════════════════════════════════════════════════════
# Stage 2: Distroless Production Runtime (runner)
# ═══════════════════════════════════════════════════════════════════════
FROM gcr.io/distroless/python3-debian12:nonroot AS runner

WORKDIR /app

# Copy pre-compiled virtual environment and libraries from builder
COPY --from=builder /opt/venv /opt/venv

# Copy application source code
COPY --chown=nonroot:nonroot . /app

# Configure environment variables
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app

# Execute as non-root user (UID 65532 in distroless)
USER nonroot

# Expose HTTP port
EXPOSE 8000

# Entrypoint running Uvicorn over uvloop with optimized production workers
ENTRYPOINT ["/opt/venv/bin/uvicorn", "gateway.main:app", "--host", "0.0.0.0", "--port", "8000", "--loop", "uvloop", "--no-access-log"]
