{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowAccessToCorporateDataLakeOnly",
      "Effect": "Allow",
      "Principal": "*",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::corporate-datalake-prod",
        "arn:aws:s3:::corporate-datalake-prod/*"
      ]
    },
    {
      "Sid": "DenyAccessToExternalBuckets",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:PrincipalAccount": "123456789012"
        }
      }
    }
  ]
}
