{
  "defaultAction": "SCMP_ACT_ERRNO",
  "architectures": [
    "SCMP_ARCH_X86_64",
    "SCMP_ARCH_AARCH64"
  ],
  "syscalls": [
    {
      "names": [
        "read", "write", "readv", "writev",
        "open", "openat", "close", "stat", "fstat", "lstat",
        "poll", "epoll_create1", "epoll_ctl", "epoll_wait",
        "lseek", "mmap", "mprotect", "munmap", "brk",
        "rt_sigaction", "rt_sigprocmask", "rt_sigreturn",
        "ioctl", "access", "pipe", "pipe2", "select",
        "sched_yield", "nanosleep", "getpid", "getppid",
        "clone", "fork", "vfork", "execve", "exit", "exit_group",
        "wait4", "uname", "fcntl", "getcwd", "chdir",
        "mkdir", "rmdir", "unlink", "unlinkat", "rename", "renameat",
        "socket", "connect", "sendto", "recvfrom", "getsockopt", "setsockopt"
      ],
      "action": "SCMP_ACT_ALLOW"
    },
    {
      "names": [
        "mount", "umount2", "pivot_root",
        "reboot", "swapon", "swapoff",
        "kexec_load", "init_module", "finit_module", "delete_module",
        "bpf", "perf_event_open", "userfaultfd",
        "ptrace", "process_vm_readv", "process_vm_writev"
      ],
      "action": "SCMP_ACT_KILL"
    }
  ]
}
