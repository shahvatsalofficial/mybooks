# syntax=docker/dockerfile:1.4
FROM ubuntu:24.04 AS base

ENV DEBIAN_FRONTEND=noninteractive
ENV NODE_ENV=production

# Install minimal required build runtimes
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    git \
    iptables \
    iproute2 \
    build-essential \
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Install modern Node.js LTS
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Install Claude Code globally with locked integrity
RUN npm install -g @anthropic-ai/claude-code --ignore-scripts

# Create unprivileged agent user
RUN groupadd -g 10001 agentgroup && \
    useradd -u 10001 -g agentgroup -m -s /bin/bash agentuser

# Set up clean workspace mount points
RUN mkdir -p /workspace /ephemeral-scratch && \
    chown -R agentuser:agentgroup /workspace /ephemeral-scratch

# Enforce secure environment variables
ENV PATH="/home/agentuser/.local/bin:${PATH}"
ENV NPM_CONFIG_IGNORE_SCRIPTS=true
ENV PIP_NO_BUILD_ISOLATION=true

USER agentuser
WORKDIR /workspace

ENTRYPOINT ["claude"]
