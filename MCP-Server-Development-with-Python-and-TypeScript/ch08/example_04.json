{
  "mcpServers": {
    "project-notes": {
      "command": "npx",
      "args": ["-y", "@vatsal/notes-mcp"],
      "autoApprove": [
        "search_notes",
        "read_note_resource"
      ]
    },
    "database-tools": {
      "command": "uvx",
      "args": ["postgres-mcp"],
      "env": {
        "DATABASE_URL": "postgresql://postgres:secret@localhost:5432/dev_db"
      },
      "autoApprove": [
        "query_schema"
      ]
    }
  }
}
