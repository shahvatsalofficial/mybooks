# Recipe 06.3: Production Rootless Multi-Stage Dockerfile for FastMCP
# Stage 1: Build & Dependency Wheel Resolution
FROM python:3.11-slim AS builder

WORKDIR /app
RUN pip install --no-cache-dir --upgrade pip uv

COPY requirements.txt .
RUN uv pip install --system --no-cache-dir -r requirements.txt

# Stage 2: Minimal Hardened Runtime
FROM python:3.11-slim AS runtime

# Create dedicated non-root application user and group
RUN groupadd -g 10001 mcpuser && \
    useradd -u 10001 -g mcpuser -s /bin/bash -m mcpuser

WORKDIR /home/mcpuser/app

# Copy resolved site-packages and binaries from builder
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

COPY . .
RUN chown -R mcpuser:mcpuser /home/mcpuser/app

# Enforce strictly unprivileged UID execution
USER 10001:10001

EXPOSE 8000
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/home/mcpuser/app

ENTRYPOINT ["python", "-m", "uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000"]
