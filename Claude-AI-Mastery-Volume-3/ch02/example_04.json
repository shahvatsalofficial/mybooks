{
  "Version": "2012-10-17",
  "Id": "default",
  "Statement": [
    {
      "Sid": "AllowBedrockAgentInvocation",
      "Effect": "Allow",
      "Principal": {
        "Service": "bedrock.amazonaws.com"
      },
      "Action": "lambda:InvokeFunction",
      "Resource": "arn:aws:lambda:us-east-1:123456789012:function:BedrockTradeReconHandler",
      "Condition": {
        "ArnEquals": {
          "aws:SourceArn": "arn:aws:bedrock:us-east-1:123456789012:agent/AGNT01928374"
        }
      }
    }
  ]
}
