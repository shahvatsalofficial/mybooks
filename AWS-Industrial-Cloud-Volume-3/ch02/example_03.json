// Account A (111122223333) Key Policy: Granting Cross-Account Access to Account B
{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowAccountBCrossAccountAccess",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::444455556666:root"
      },
      "Action": [
        "kms:Decrypt",
        "kms:DescribeKey",
        "kms:GenerateDataKey",
        "kms:CreateGrant"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:EncryptionContext:Environment": "Production"
        }
      }
    }
  ]
}
